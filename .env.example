# Копировать в .env (для drizzle-kit) и в .dev.vars (для wrangler pages dev).

# Neon — строка подключения к pooled-эндпоинту
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Авторизация (этап 1)
SESSION_SECRET=сгенерировать-длинную-случайную-строку
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
ALLOWED_TELEGRAM_IDS=11111111,22222222

# Необязательное
MYMEMORY_EMAIL=you@example.com
OPENROUTER_API_KEY=
