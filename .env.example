# Копировать в .env (для drizzle-kit) и в .dev.vars (для wrangler pages dev).

# Neon — строка подключения к pooled-эндпоинту
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Авторизация (этап 1)
SESSION_SECRET=сгенерировать: openssl rand -hex 32
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Кто может входить — в таблице users (первый вошедший становится владельцем).

# Фронт (Vite, build-time; в Cloudflare Pages — plaintext build-переменные).
VITE_TELEGRAM_BOT_USERNAME=my_app_bot
# MyMemory дёргается из браузера; email поднимает лимит до ~50k/день (необяз.)
VITE_MYMEMORY_EMAIL=you@example.com

# Необязательное (этап 4)
OPENROUTER_API_KEY=
